# Variables de docker compose (opcional: sin este archivo se usan valores de desarrollo).
# Copiar a .env y cambiar los valores; .env nunca se versiona.
DB_NAME=miniaula
DB_PASSWORD=cambiar_esta_contrasena
JWT_SECRET=cambiar_este_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=24h
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173
LOGIN_RATE_LIMIT_MAX=10
# Puerto del host para MySQL (cambiar si el 3306 está ocupado)
DB_HOST_PORT=3306
